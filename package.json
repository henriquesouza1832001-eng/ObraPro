{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "worker:typecheck": "tsc -p cloudflare/tsconfig.json",
        "worker:dev": "wrangler dev --config wrangler.preview.jsonc",
        "worker:build": "wrangler deploy --config wrangler.preview.jsonc --dry-run --outdir cloudflare/dist"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260918.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^8.0.0",
        "wrangler": "^4.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
