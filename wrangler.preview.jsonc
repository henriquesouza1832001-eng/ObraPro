{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "obrapro-preview",
    "main": "cloudflare/preview-worker.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
