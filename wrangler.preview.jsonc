{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "obrapro-preview",
    "main": "cloudflare/src/index.ts",
    "compatibility_date": "2026-09-19",
    "assets": {
        "directory": "cloudflare/public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none"
    },
    "d1_databases": [
        {
            "binding": "COURSES_DB",
            "database_name": "obrapro-preview-db",
            "database_id": "a5226f03-2d2c-4218-ac42-3fe1753d6a6a",
            "migrations_dir": "cloudflare/migrations"
        },
        {
            "binding": "AUTH_DB",
            "database_name": "obrapro-preview-db",
            "database_id": "a5226f03-2d2c-4218-ac42-3fe1753d6a6a",
            "migrations_dir": "cloudflare/migrations"
        },
        {
            "binding": "OPERATIONS_DB",
            "database_name": "obrapro-preview-db",
            "database_id": "a5226f03-2d2c-4218-ac42-3fe1753d6a6a",
            "migrations_dir": "cloudflare/migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "EVIDENCE_BUCKET",
            "bucket_name": "obrapro-preview-files"
        }
    ]
}
